<import FinancePure from "./FinancePure.nova" /|

<contract state FinanceLedger>
  route: Route <- {
    path <- "/expense";
  } {
    @route_changed(next: Route) -> next;
    @choose_expense -> { path <- "/expense"; };
    @choose_income -> { path <- "/income"; };
    @choose_transfer -> { path <- "/transfer"; };
    @restore -> route;
  };

  historyFilter: HistoryFilter <- "all" {
    @filter_all -> "all";
    @filter_expense -> "expense";
    @filter_income -> "income";
    @filter_transfer -> "transfer";
  };

  ledger: LedgerV1 <- emptyLedger() {
    @save_expense -> applyExpense ledger draftCategory draftAmount fromAccount note;
    @save_income -> applyIncome ledger draftCategory draftAmount toAccount note;
    @save_transfer -> applyTransfer ledger fromAccount toAccount draftAmount feeAmount note;
    @ledger_hydrated(value: unknown) -> ledgerFromStored value;
  };

  expenseTabLabel: string <- "Pengeluaran";
  incomeTabLabel: string <- "Pemasukan";
  transferTabLabel: string <- "Transfer";
  inputTabLabel: string <- "Input";
  historyTabLabel: string <- "Riwayat";
  filterAllLabel: string <- "Semua";
  filterExpenseLabel: string <- "Keluar";
  filterIncomeLabel: string <- "Masuk";
  filterTransferLabel: string <- "Transfer";

  inputTabClass: string <- "tab-button tab-button-selected" {
    @route_changed(next: Route) -> inputTabClassFor next.path;
    @choose_expense -> "tab-button tab-button-selected";
    @choose_income -> "tab-button tab-button-selected";
    @choose_transfer -> "tab-button tab-button-selected";
  };

  historyTabClass: string <- "tab-button" {
    @route_changed(next: Route) -> historyTabClassFor next.path;
  };

  expenseTypeClass: string <- "type-button expense-action type-button-selected" {
    @route_changed(next: Route) -> typeButtonClass next.path "/expense" "type-button expense-action";
    @choose_expense -> "type-button expense-action type-button-selected";
    @choose_income -> "type-button expense-action";
    @choose_transfer -> "type-button expense-action";
  };

  incomeTypeClass: string <- "type-button income-action" {
    @route_changed(next: Route) -> typeButtonClass next.path "/income" "type-button income-action";
    @choose_expense -> "type-button income-action";
    @choose_income -> "type-button income-action type-button-selected";
    @choose_transfer -> "type-button income-action";
  };

  transferTypeClass: string <- "type-button transfer-action" {
    @route_changed(next: Route) -> typeButtonClass next.path "/transfer" "type-button transfer-action";
    @choose_expense -> "type-button transfer-action";
    @choose_income -> "type-button transfer-action";
    @choose_transfer -> "type-button transfer-action type-button-selected";
  };

  filterAllClass: string <- "filter-button filter-button-selected" {
    @filter_all -> "filter-button filter-button-selected";
    @filter_expense -> "filter-button";
    @filter_income -> "filter-button";
    @filter_transfer -> "filter-button";
    @ledger_hydrated(value: unknown) -> filterButtonClass historyFilter "all";
  };

  filterExpenseClass: string <- "filter-button" {
    @filter_expense -> "filter-button filter-button-selected";
    @filter_all -> "filter-button";
    @filter_income -> "filter-button";
    @filter_transfer -> "filter-button";
    @ledger_hydrated(value: unknown) -> filterButtonClass historyFilter "expense";
  };

  filterIncomeClass: string <- "filter-button" {
    @filter_income -> "filter-button filter-button-selected";
    @filter_all -> "filter-button";
    @filter_expense -> "filter-button";
    @filter_transfer -> "filter-button";
    @ledger_hydrated(value: unknown) -> filterButtonClass historyFilter "income";
  };

  filterTransferClass: string <- "filter-button" {
    @filter_transfer -> "filter-button filter-button-selected";
    @filter_all -> "filter-button";
    @filter_expense -> "filter-button";
    @filter_income -> "filter-button";
    @ledger_hydrated(value: unknown) -> filterButtonClass historyFilter "transfer";
  };

  netTotalLabel: string <- "Rp 0" {
    @ledger_hydrated(value: unknown) -> formatCurrency (ledgerNet (ledgerFromStored value));
    @save_expense -> formatCurrency (ledgerNet (applyExpense ledger draftCategory draftAmount fromAccount note));
    @save_income -> formatCurrency (ledgerNet (applyIncome ledger draftCategory draftAmount toAccount note));
    @save_transfer -> formatCurrency (ledgerNet (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note));
  };

  incomeTotalLabel: string <- "Rp 0" {
    @ledger_hydrated(value: unknown) -> formatCurrency (ledgerIncome (ledgerFromStored value));
    @save_expense -> formatCurrency (ledgerIncome (applyExpense ledger draftCategory draftAmount fromAccount note));
    @save_income -> formatCurrency (ledgerIncome (applyIncome ledger draftCategory draftAmount toAccount note));
    @save_transfer -> formatCurrency (ledgerIncome (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note));
  };

  expenseTotalLabel: string <- "Rp 0" {
    @ledger_hydrated(value: unknown) -> formatCurrency (ledgerExpense (ledgerFromStored value));
    @save_expense -> formatCurrency (ledgerExpense (applyExpense ledger draftCategory draftAmount fromAccount note));
    @save_income -> formatCurrency (ledgerExpense (applyIncome ledger draftCategory draftAmount toAccount note));
    @save_transfer -> formatCurrency (ledgerExpense (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note));
  };

  feeTotalLabel: string <- "Rp 0" {
    @ledger_hydrated(value: unknown) -> formatCurrency (ledgerFee (ledgerFromStored value));
    @save_transfer -> formatCurrency (ledgerFee (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note));
  };

  transferTotalLabel: string <- "Rp 0" {
    @ledger_hydrated(value: unknown) -> formatCurrency (ledgerTransfer (ledgerFromStored value));
    @save_expense -> formatCurrency (ledgerTransfer (applyExpense ledger draftCategory draftAmount fromAccount note));
    @save_income -> formatCurrency (ledgerTransfer (applyIncome ledger draftCategory draftAmount toAccount note));
    @save_transfer -> formatCurrency (ledgerTransfer (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note));
  };

  draftCategory: string <- "Makan" {
    @set_category(value: string) -> value;
    @choose_expense -> "Makan";
    @choose_income -> "Gaji";
    @save_expense -> "Makan";
    @save_income -> "Gaji";
  };

  draftAmount: number <- 0 {
    @set_amount(value: number) -> value;
    @save_expense -> 0;
    @save_income -> 0;
    @save_transfer -> 0;
  };

  feeAmount: number <- 0 {
    @set_fee(value: number) -> value;
    @save_transfer -> 0;
  };

  fromAccount: string <- "Tunai" {
    @set_from_account(value: string) -> value;
    @save_expense -> "Tunai";
    @save_transfer -> "Tunai";
  };

  toAccount: string <- "BCA" {
    @set_to_account(value: string) -> value;
    @save_income -> "BCA";
    @save_transfer -> "BCA";
  };

  note: string <- "" {
    @set_note(value: string) -> value;
    @save_expense -> "";
    @save_income -> "";
    @save_transfer -> "";
  };

  transactionCount: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerCount (ledgerFromStored value);
    @save_expense -> ledgerCount (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerCount (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerCount (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  netTotal: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerNet (ledgerFromStored value);
    @save_expense -> ledgerNet (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerNet (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerNet (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  expenseTotal: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerExpense (ledgerFromStored value);
    @save_expense -> ledgerExpense (applyExpense ledger draftCategory draftAmount fromAccount note);
  };

  incomeTotal: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerIncome (ledgerFromStored value);
    @save_income -> ledgerIncome (applyIncome ledger draftCategory draftAmount toAccount note);
  };

  transferTotal: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerTransfer (ledgerFromStored value);
    @save_transfer -> ledgerTransfer (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  feeTotal: number <- 0 {
    @ledger_hydrated(value: unknown) -> ledgerFee (ledgerFromStored value);
    @save_transfer -> ledgerFee (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  statusMessage: string <- "Memuat ledger tersimpan..." {
    @ledger_hydrated(value: unknown) -> "Ledger dimuat dari penyimpanan lokal.";
    @load_failed(message: string) -> "Gagal memuat ledger: " + message;
    @save_expense -> "Pengeluaran tersimpan ke penyimpanan lokal.";
    @save_income -> "Pemasukan tersimpan ke penyimpanan lokal.";
    @save_transfer -> "Transfer tersimpan ke penyimpanan lokal.";
  };

  allLine1: string <- "Belum ada transaksi." {
    @ledger_hydrated(value: unknown) -> ledgerLine1 (ledgerFromStored value);
    @save_expense -> ledgerLine1 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerLine1 (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerLine1 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  allLine2: string <- "Transaksi terbaru akan muncul di sini." {
    @ledger_hydrated(value: unknown) -> ledgerLine2 (ledgerFromStored value);
    @save_expense -> ledgerLine2 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerLine2 (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerLine2 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  allLine3: string <- "Export JSON ikut diperbarui setiap simpan." {
    @ledger_hydrated(value: unknown) -> ledgerLine3 (ledgerFromStored value);
    @save_expense -> ledgerLine3 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerLine3 (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerLine3 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  allLine4: string <- "Gunakan filter di halaman riwayat." {
    @ledger_hydrated(value: unknown) -> ledgerLine4 (ledgerFromStored value);
    @save_expense -> ledgerLine4 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerLine4 (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerLine4 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  expenseLine1: string <- "Belum ada pengeluaran." {
    @save_expense -> ledgerExpenseRecent1 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @ledger_hydrated(value: unknown) -> ledgerExpenseRecent1 (ledgerFromStored value);
  };

  expenseLine2: string <- "Pengeluaran yang dicatat akan muncul di sini." {
    @save_expense -> ledgerExpenseRecent2 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @ledger_hydrated(value: unknown) -> ledgerExpenseRecent2 (ledgerFromStored value);
  };

  incomeLine1: string <- "Belum ada pemasukan." {
    @save_income -> ledgerIncomeRecent1 (applyIncome ledger draftCategory draftAmount toAccount note);
    @ledger_hydrated(value: unknown) -> ledgerIncomeRecent1 (ledgerFromStored value);
  };

  incomeLine2: string <- "Pemasukan yang dicatat akan muncul di sini." {
    @save_income -> ledgerIncomeRecent2 (applyIncome ledger draftCategory draftAmount toAccount note);
    @ledger_hydrated(value: unknown) -> ledgerIncomeRecent2 (ledgerFromStored value);
  };

  transferLine1: string <- "Belum ada transfer." {
    @save_transfer -> ledgerTransferRecent1 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
    @ledger_hydrated(value: unknown) -> ledgerTransferRecent1 (ledgerFromStored value);
  };

  transferLine2: string <- "Transfer yang dicatat akan muncul di sini." {
    @save_transfer -> ledgerTransferRecent2 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
    @ledger_hydrated(value: unknown) -> ledgerTransferRecent2 (ledgerFromStored value);
  };

  filterTitle: string <- "Semua transaksi" {
    @filter_all -> "Semua transaksi";
    @filter_expense -> "Pengeluaran";
    @filter_income -> "Pemasukan";
    @filter_transfer -> "Transfer";
    @save_expense -> "Semua transaksi";
    @save_income -> "Semua transaksi";
    @save_transfer -> "Semua transaksi";
  };

  visibleLine1: string <- "Belum ada transaksi." {
    @ledger_hydrated(value: unknown) -> visibleLine1 (ledgerFromStored value) historyFilter;
    @save_expense -> ledgerLine1 (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> ledgerLine1 (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> ledgerLine1 (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
    @filter_all -> ledgerLine1 ledger;
    @filter_expense -> ledgerExpenseRecent1 ledger;
    @filter_income -> ledgerIncomeRecent1 ledger;
    @filter_transfer -> ledgerTransferRecent1 ledger;
  };

  visibleLine2: string <- "Transaksi terbaru akan muncul di sini." {
    @ledger_hydrated(value: unknown) -> visibleLine2 (ledgerFromStored value) historyFilter;
    @save_expense -> visibleLine1;
    @save_income -> visibleLine1;
    @save_transfer -> visibleLine1;
    @filter_all -> ledgerLine2 ledger;
    @filter_expense -> ledgerExpenseRecent2 ledger;
    @filter_income -> ledgerIncomeRecent2 ledger;
    @filter_transfer -> ledgerTransferRecent2 ledger;
  };

  visibleLine3: string <- "Export JSON ikut diperbarui setiap simpan." {
    @ledger_hydrated(value: unknown) -> visibleLine3 (ledgerFromStored value) historyFilter;
    @save_expense -> visibleLine2;
    @save_income -> visibleLine2;
    @save_transfer -> visibleLine2;
    @filter_all -> ledgerLine3 ledger;
    @filter_expense -> visibleLine3 ledger historyFilter;
    @filter_income -> visibleLine3 ledger historyFilter;
    @filter_transfer -> visibleLine3 ledger historyFilter;
  };

  visibleLine4: string <- "Gunakan filter di halaman riwayat." {
    @ledger_hydrated(value: unknown) -> visibleLine4 (ledgerFromStored value) historyFilter;
    @save_expense -> visibleLine3;
    @save_income -> visibleLine3;
    @save_transfer -> visibleLine3;
    @filter_all -> ledgerLine4 ledger;
    @filter_expense -> visibleLine4 ledger historyFilter;
    @filter_income -> visibleLine4 ledger historyFilter;
    @filter_transfer -> visibleLine4 ledger historyFilter;
  };

  chartMaxValue: number <- 1 {
    @ledger_hydrated(value: unknown) -> chartMaxFromLedger (ledgerFromStored value);
    @save_expense -> chartMaxFromLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> chartMaxFromLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> chartMaxFromLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  incomeBarClass: string <- "bar-fill bar-h-0" {
    @ledger_hydrated(value: unknown) -> barIncomeClassForLedger (ledgerFromStored value);
    @save_expense -> barIncomeClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> barIncomeClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> barIncomeClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  expenseBarClass: string <- "bar-fill bar-h-0" {
    @ledger_hydrated(value: unknown) -> barExpenseClassForLedger (ledgerFromStored value);
    @save_expense -> barExpenseClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> barExpenseClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> barExpenseClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  transferBarClass: string <- "bar-fill bar-h-0" {
    @ledger_hydrated(value: unknown) -> barTransferClassForLedger (ledgerFromStored value);
    @save_expense -> barTransferClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> barTransferClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> barTransferClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieIncomeClass: string <- "pie-segment pie-income pie-w-0" {
    @ledger_hydrated(value: unknown) -> pieIncomeClassForLedger (ledgerFromStored value);
    @save_expense -> pieIncomeClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieIncomeClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieIncomeClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieExpenseClass: string <- "pie-segment pie-expense pie-w-0" {
    @ledger_hydrated(value: unknown) -> pieExpenseClassForLedger (ledgerFromStored value);
    @save_expense -> pieExpenseClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieExpenseClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieExpenseClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieTransferClass: string <- "pie-segment pie-transfer pie-w-0" {
    @ledger_hydrated(value: unknown) -> pieTransferClassForLedger (ledgerFromStored value);
    @save_expense -> pieTransferClassForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieTransferClassForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieTransferClassForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieIncomeLabel: string <- "0%" {
    @ledger_hydrated(value: unknown) -> pieIncomeLabelForLedger (ledgerFromStored value);
    @save_expense -> pieIncomeLabelForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieIncomeLabelForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieIncomeLabelForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieExpenseLabel: string <- "0%" {
    @ledger_hydrated(value: unknown) -> pieExpenseLabelForLedger (ledgerFromStored value);
    @save_expense -> pieExpenseLabelForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieExpenseLabelForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieExpenseLabelForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  pieTransferLabel: string <- "0%" {
    @ledger_hydrated(value: unknown) -> pieTransferLabelForLedger (ledgerFromStored value);
    @save_expense -> pieTransferLabelForLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> pieTransferLabelForLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> pieTransferLabelForLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };

  exportJson: string <- "{\"transactions\":[]}" {
    @ledger_hydrated(value: unknown) -> encodeLedger (ledgerFromStored value);
    @save_expense -> encodeLedger (applyExpense ledger draftCategory draftAmount fromAccount note);
    @save_income -> encodeLedger (applyIncome ledger draftCategory draftAmount toAccount note);
    @save_transfer -> encodeLedger (applyTransfer ledger fromAccount toAccount draftAmount feeAmount note);
  };
/|
