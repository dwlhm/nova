<contract capability FinancePersistenceLifecycle>
  emits {
    @ledger_synced: void;
  }
/|

<import external storage from "@env/storage">
  operation load {
    input {
      key: string;
    }

    output unknown;
  }

  operation set {
    input {
      key: string;
      value: unknown;
    }

    output void;
  }
/|

<import state ledger from "./FinanceStore.nova" /|
<import event @restore, @save_expense, @save_income, @save_transfer from "./FinanceStore.nova" /|
<import event @ledger_hydrated, @load_failed from "./FinanceStore.nova" /|

<lifecycle mount>
  void -> @restore;
/|

<lifecycle after @restore>
  void |> storage.load key <- "finance_ledger_v1" onSuccess <- @ledger_hydrated onFailure <- @load_failed;
/|

<lifecycle after @ledger_hydrated>
  void -> @ledger_synced;
/|

<lifecycle after @save_expense>
  ledger |> storage.set key <- "finance_ledger_v1" value <- ledger;
/|

<lifecycle after @save_income>
  ledger |> storage.set key <- "finance_ledger_v1" value <- ledger;
/|

<lifecycle after @save_transfer>
  ledger |> storage.set key <- "finance_ledger_v1" value <- ledger;
/|
