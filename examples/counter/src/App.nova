<contract state Counter>
  count: number <- 0 {
    @increment -> count + 1;
    @decrement -> count - 1;
    @reset -> 0;
  };
/|

<template target <- web>
  <surface class <- "counter-shell">
    <text class <- "counter-title" value <- "Nova Counter" /|
    <text class <- "counter-value" value <- "Count: " + count /|
    <row class <- "counter-actions">
      <button on_press -> @decrement>
        <text value <- "-" /|
      /|
      <button on_press -> @reset>
        <text value <- "Reset" /|
      /|
      <button on_press -> @increment>
        <text value <- "+" /|
      /|
    /|
  /|
/|

<template target <- android>
  <surface class <- "counter-shell">
    <text class <- "counter-title" value <- "Nova Counter" /|
    <text class <- "counter-value" value <- "Count: " + count /|
    <row class <- "counter-actions">
      <button on_press -> @decrement>
        <text value <- "-" /|
      /|
      <button on_press -> @reset>
        <text value <- "Reset" /|
      /|
      <button on_press -> @increment>
        <text value <- "+" /|
      /|
    /|
  /|
/|
